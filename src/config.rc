// config.rc - configuration dialog of the DSP
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_CONFIG DIALOGEX 0, 0, 300, 292
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Binaural Speaker Virtualizer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Binaural stereo input expected. For ordinary stereo recordings enable 'Stereo source'. Not for headphones.", -1, 8, 6, 284, 18

    LTEXT           "Speaker spacing", -1, 8, 30, 90, 10
    CONTROL         "", IDC_SL_SPACING, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 27, 140, 16
    LTEXT           "", IDC_TX_SPACING, 244, 30, 52, 10

    LTEXT           "Listening distance", -1, 8, 48, 90, 10
    CONTROL         "", IDC_SL_DIST, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 45, 140, 16
    LTEXT           "", IDC_TX_DIST, 244, 48, 52, 10

    LTEXT           "Head circumference", -1, 8, 66, 90, 10
    CONTROL         "", IDC_SL_HEAD, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 63, 140, 16
    LTEXT           "", IDC_TX_HEAD, 244, 66, 52, 10

    LTEXT           "Regularization", -1, 8, 84, 90, 10
    CONTROL         "", IDC_SL_REG, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 81, 140, 16
    LTEXT           "", IDC_TX_REG, 244, 84, 52, 10

    LTEXT           "Max filter boost", -1, 8, 102, 90, 10
    CONTROL         "", IDC_SL_BOOST, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 99, 140, 16
    LTEXT           "", IDC_TX_BOOST, 244, 102, 52, 10

    LTEXT           "Canceller lower limit", -1, 8, 120, 90, 10
    CONTROL         "", IDC_SL_LOW, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 117, 140, 16
    LTEXT           "", IDC_TX_LOW, 244, 120, 52, 10

    LTEXT           "Canceller upper limit", -1, 8, 138, 90, 10
    CONTROL         "", IDC_SL_FREQ, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 135, 140, 16
    LTEXT           "", IDC_TX_FREQ, 244, 138, 52, 10

    LTEXT           "Center level", -1, 8, 156, 90, 10
    CONTROL         "", IDC_SL_CENTER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 153, 140, 16
    LTEXT           "", IDC_TX_CENTER, 244, 156, 52, 10

    LTEXT           "Output gain", -1, 8, 174, 90, 10
    CONTROL         "", IDC_SL_GAIN, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 171, 140, 16
    LTEXT           "", IDC_TX_GAIN, 244, 174, 52, 10

    LTEXT           "Virtual speaker angle", -1, 8, 192, 90, 10
    CONTROL         "", IDC_SL_VIRT, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 189, 140, 16
    LTEXT           "", IDC_TX_VIRT, 244, 192, 52, 10

    LTEXT           "", IDC_TX_GEOM, 8, 212, 284, 10

    AUTOCHECKBOX    "Auto level (normalise average gain)", IDC_CHK_AUTO, 8, 226, 284, 10
    AUTOCHECKBOX    "Exact rigid-sphere head model (otherwise Woodworth + Brown/Duda)", IDC_CHK_EXACT, 8, 238, 284, 10
    AUTOCHECKBOX    "Stereo source (ordinary stereo input, via virtual speakers)", IDC_CHK_STEREO, 8, 250, 284, 10

    PUSHBUTTON      "Defaults", IDC_BTN_RESET, 8, 265, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 188, 265, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 265, 50, 14
END
