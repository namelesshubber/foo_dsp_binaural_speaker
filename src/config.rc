// config.rc - configuration dialog of the DSP
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_CONFIG DIALOGEX 0, 0, 300, 216
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Speaker Virtualizer (CMSS-3D Virtual style)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Input must be a binaural stereo signal (e.g. Dolby Headphone output). Place this DSP after it.", -1, 8, 6, 284, 18

    LTEXT           "Speaker half-angle", -1, 8, 30, 90, 10
    CONTROL         "", IDC_SL_ANGLE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 27, 140, 16
    LTEXT           "", IDC_TX_ANGLE, 244, 30, 52, 10

    LTEXT           "Head radius", -1, 8, 50, 90, 10
    CONTROL         "", IDC_SL_HEAD, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 47, 140, 16
    LTEXT           "", IDC_TX_HEAD, 244, 50, 52, 10

    LTEXT           "Regularization", -1, 8, 70, 90, 10
    CONTROL         "", IDC_SL_REG, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 67, 140, 16
    LTEXT           "", IDC_TX_REG, 244, 70, 52, 10

    LTEXT           "Max filter boost", -1, 8, 90, 90, 10
    CONTROL         "", IDC_SL_BOOST, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 87, 140, 16
    LTEXT           "", IDC_TX_BOOST, 244, 90, 52, 10

    LTEXT           "Canceller lower limit", -1, 8, 110, 90, 10
    CONTROL         "", IDC_SL_LOW, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 107, 140, 16
    LTEXT           "", IDC_TX_LOW, 244, 110, 52, 10

    LTEXT           "Canceller upper limit", -1, 8, 130, 90, 10
    CONTROL         "", IDC_SL_FREQ, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 127, 140, 16
    LTEXT           "", IDC_TX_FREQ, 244, 130, 52, 10

    LTEXT           "Output gain", -1, 8, 150, 90, 10
    CONTROL         "", IDC_SL_GAIN, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 100, 147, 140, 16
    LTEXT           "", IDC_TX_GAIN, 244, 150, 52, 10

    AUTOCHECKBOX    "Auto level (normalise average gain)", IDC_CHK_AUTO, 8, 170, 200, 10
    AUTOCHECKBOX    "Exact rigid-sphere head model (otherwise Woodworth + Brown/Duda)", IDC_CHK_EXACT, 8, 182, 284, 10

    PUSHBUTTON      "Defaults", IDC_BTN_RESET, 8, 197, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 188, 197, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 197, 50, 14
END
